# MediKiosk Environment Configuration

# Database Configuration (Neon PostgreSQL)
# When provided, connects to Neon managed Postgres.
# If unset or unreachable during development, falls back automatically to local sqlite:///./medikiosk.db
NEON_DATABASE_URL=postgresql+asyncpg://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?ssl=require

# Neon Auth / Session Configuration
# Replace the placeholders below with your own randomly generated secrets.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NEON_AUTH_URL=https://auth.neon.tech
NEON_AUTH_COOKIE_SECRET=__CHANGE_ME_GENERATE_A_RANDOM_SECRET__
JWT_SECRET=__CHANGE_ME_GENERATE_A_RANDOM_SECRET__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM Configuration (NVIDIA Nemotron 3 Ultra via OpenRouter)
# Required model identifier: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local LLM (free, no API key): Ollama or any OpenAI-compatible local server.
# Preferred over OpenRouter for chat + follow-up question generation.
# Setup: winget install Ollama.Ollama  &&  ollama pull llama3.2
LOCAL_LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=20

# Speech Recognition (free/local: 'auto' = IndicConformer for hi/gu, Whisper for en)
SPEECH_PROVIDER=auto
WHISPER_MODEL_PATH=model/whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# OCR Service Configuration (Local PaddleOCR from model/paddleocr)
OCR_PROVIDER=paddleocr
PADDLEOCR_MODEL_PATH=model/paddleocr
TESSERACT_PATH=
MAX_DOCUMENT_UPLOAD_MB=25
OCR_TIMEOUT_SECONDS=90

# Vector Database (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# ABDM / FHIR Gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BRIDGE_URL=https://dev.abdm.gov.in/gateway
ABDM_MODE=sandbox

# Application Ports & URLs
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
APP_ENV=development
DEBUG=True
